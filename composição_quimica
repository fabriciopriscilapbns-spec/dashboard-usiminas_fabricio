  for(let i=0;i<P.length-1;i++){const p0=P[i-1]||P[i],p1=P[i],p2=P[i+1],p3=P[i+2]||p2;
    const c1=[p1[0]+(p2[0]-p0[0])/6,p1[1]+(p2[1]-p0[1])/6],c2=[p2[0]-(p3[0]-p1[0])/6,p2[1]-(p3[1]-p1[1])/6];
    const lo=Math.min(p1[1],p2[1]),hi=Math.max(p1[1],p2[1]),cl=y=>Math.max(lo,Math.min(hi,y));
    path+=` C${c1[0].toFixed(1)},${cl(c1[1]).toFixed(1)} ${c2[0].toFixed(1)},${cl(c2[1]).toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;}
  const area=path+` L${P[P.length-1][0]},${T+ih} L${P[0][0]},${T+ih} Z`;
  let g="";for(let v=0;v<=top;v+=step){g+=`<line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}" stroke="var(--line)"/><text x="${L-8}" y="${Y(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)">${v}</text>`;}
  const every=Math.max(1,Math.ceil(days.length/16));
  const lab=d=>String(d%100).padStart(2,"0")+"/"+String(Math.floor(d/100)%100).padStart(2,"0");
  const pts=days.map((d,i)=>{const [x,y]=P[i],v=cnt.get(d),t=String(v),w=t.length*7+12;
    return `<g class="pt" tabindex="0" role="button" data-d="${d}" aria-label="${lab(d)}: ${v} corridas fora de faixa"><title>${lab(d)}: ${v} de ${tot.get(d)} corridas (${pct(v,tot.get(d))})</title>
      <circle cx="${x}" cy="${y}" r="14" fill="transparent"/><circle cx="${x}" cy="${y}" r="4.5" fill="var(--bar)" stroke="var(--card)" stroke-width="2"/>
      <rect x="${x-w/2}" y="${y-27}" width="${w}" height="17" rx="3" fill="var(--card)" stroke="var(--line)"/><text x="${x}" y="${y-14.5}" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--ink)">${t}</text>
      ${i%every===0||i===days.length-1?`<text x="${x}" y="${H-12}" text-anchor="middle" font-size="11" fill="var(--muted)">${lab(d)}</text>`:""}</g>`}).join("");
  el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Evolução diária de corridas fora de faixa">${g}<line x1="${L}" x2="${W-R}" y1="${T+ih}" y2="${T+ih}" stroke="var(--muted)" stroke-opacity=".5"/>
    <path d="${area}" fill="var(--bar)" fill-opacity=".09"/><path d="${path}" fill="none" stroke="var(--bar)" stroke-width="2.2"/>${pts}</svg>`;
  if(!stat)el.querySelectorAll(".pt").forEach(p=>{p.onclick=()=>openDay(+p.dataset.d);p.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();openDay(+p.dataset.d);}};});
}
