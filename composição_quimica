  src.forEach(r=>{tot.set(r.dt,(tot.get(r.dt)||0)+1);if(hit(r))cnt.set(r.dt,(cnt.get(r.dt)||0)+1);});
  const days=[...cnt.keys()].sort((a,b)=>a-b);
  const el=target||$("chDia");
  if(!days.length){el.innerHTML='<div class="empty">Nenhuma corrida fora de faixa neste filtro.</div>';return;}
  const W=1100,H=250,L=36,R=24,T=30,B=34,iw=W-L-R,ih=H-T-B;
  const mx=Math.max(...days.map(d=>cnt.get(d))); const step=mx<=5?1:mx<=10?2:Math.ceil(mx/5);const top=Math.ceil(mx/step)*step;
  const X=i=>L+(days.length===1?iw/2:i*iw/(days.length-1)), Y=v=>T+ih-(v/top)*ih;
  const P=days.map((d,i)=>[X(i),Y(cnt.get(d))]);
