    ${k("Fora de faixa",fmt(R.fora.length),R.pm?mlabel(R.pm).replace(PT,"/")+": "+fmt(R.pFora.length):"")}
    ${k("% fora de faixa",f1(p)+"%",q!=null?mlabel(R.pm).replace(PT,"/")+": "+f1(q)+"%":"")}
    ${k("Variação",d==null?"–":(d>0?"▲ ":d<0?"▼ ":"")+f1(Math.abs(d))+" p.p.","vs. mês anterior",d>0.05?"up":d<-0.05?"dn":"")}
    ${k("Principal elemento",R.els[0]?esc(R.els[0][0]):"–",R.els[0]?R.els[0][1]+" corrida(s)":"")}
    ${k("Acumulado "+mk.slice(0,4),f1(pp(R.yFora.length,R.yPer.length))+"%",fmt(R.yFora.length)+" de "+fmt(R.yPer.length))}
  </div></div>
  <div class="rsec"><h2>Leitura rápida</h2><div class="lr"><ul>${leitura(R).map(t=>`<li>${esc(t)}</li>`).join("")}</ul></div></div>
  <div class="rsec"><h2>% fora de faixa por mês · <span style="color:#D98E04">■</span> mês do relatório</h2>${monthSvg(mk)}</div>
  <div class="rsec"><h2>Evolução diária · nº de corridas fora de faixa por dia</h2>${daySvg.innerHTML}</div>
  <div class="rsec r2"><div><h2>Elementos fora de faixa</h2><table><thead><tr><th>Elemento</th><th class="n">Corridas</th><th class="n">% ocorr.</th><th class="n">Mês ant.</th><th class="n">Var.</th></tr></thead><tbody>${elRows}</tbody></table></div>
    <div><h2>Por L</h2><table><thead><tr><th>L</th><th class="n">Corridas</th><th class="n">Fora</th><th class="n">%</th></tr></thead><tbody>${lRows}</tbody></table></div></div>
  <div class="rsec" style="break-inside:auto"><h2>Corridas fora de faixa do mês (${fmt(R.fora.length)})</h2><div class="rtw"><table><thead><tr><th>Corrida</th><th>Data</th><th>Elemento</th><th>Sigla</th><th>SO</th><th>L</th><th>STA</th><th>Observação</th></tr></thead><tbody>${list}</tbody></table></div></div>
  <div class="rf"><span>Fonte: Controle de Composição Química · ${esc($("loadMsg").textContent)}</span><span>Gerado em ${gen}</span></div>`;
  return R;
}
function mailText(mk){
  const R=relData(mk),m=mlabel(mk).replace(PT,"/");
  return `Assunto: Composição Química AC 1 e 2 – Corridas fora de faixa – ${m}\n\nBom dia,\n\nSegue em anexo o relatório de corridas com elemento fora de faixa de ${m}.\n\nResumo:\n`+
    leitura(R).map(t=>"- "+t).join("\n")+`\n\nO detalhamento corrida a corrida está no PDF anexo.\n\nAtenciosamente,`;
}
function openRel(){
  const ms=months().slice().reverse();$("rMes").innerHTML=ms.map(m=>`<option value="${m}">${mlabel(m)}</option>`).join("");
  $("rMes").value=$("fMes").value||ms[0];$("rMailTa").hidden=true;buildRel($("rMes").value);$("rOv").hidden=false;$("rOv").scrollTop=0;$("rPrint").focus();
}
$("btnRel").onclick=openRel;
$("rMes").onchange=()=>buildRel($("rMes").value);
$("rClose").onclick=()=>{$("rOv").hidden=true;$("btnRel").focus();};
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!$("rOv").hidden)$("rOv").hidden=true;});
$("rPrint").onclick=()=>{const t=document.title;document.title="Relatorio_Composicao_Quimica_"+mlabel($("rMes").value).replace(PT,"-");window.print();setTimeout(()=>document.title=t,1000);};
$("rMail").onclick=async()=>{const txt=mailText($("rMes").value);let ok=false;
  try{await navigator.clipboard.writeText(txt);ok=true;}catch(e){}
  if(!ok){try{const t=document.createElement("textarea");t.value=txt;document.body.appendChild(t);t.select();ok=document.execCommand("copy");t.remove();}catch(e){}}
  $("rMailTa").value=txt;$("rMailTa").hidden=ok;
  $("rMsg").innerHTML=ok?"✅ Texto do e-mail copiado. Cole no Outlook (Ctrl+V) e anexe o PDF.":"Selecione o texto abaixo (Ctrl+A, Ctrl+C) e cole no Outlook.";
};

// tabs
function showTab(t){document.querySelectorAll("nav.tabs button").forEach(b=>b.setAttribute("aria-selected",b.dataset.t===t));
  for(const s of["painel","ocorrencias","elemento"])$(s).hidden=s!==t; $("headFilters").hidden=t!=="painel";}
document.querySelectorAll("nav.tabs button").forEach(b=>b.onclick=()=>showTab(b.dataset.t));
["fMes","fEl"].forEach(id=>$(id).onchange=renderAll);
["oMes","oEl","oAll"].forEach(id=>$(id).onchange=renderOc);$("oQ").oninput=renderOc;
["aEl","aMes"].forEach(id=>$(id).onchange=renderEl);

// carregar planilha nova (lida no navegador, nada é enviado)
function parseSheet(wb){
  for(const name of wb.SheetNames){
    const a=XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,raw:false,defval:""});
    const h=a.findIndex(r=>r.some(c=>String(c).trim().toUpperCase()==="CORR")&&r.some(c=>/fora de faixa/i.test(c)));
    if(h<0)continue;
    const H=a[h].map(c=>String(c).trim().toLowerCase()); const ix=n=>H.findIndex(c=>c===n||c.startsWith(n));
    const c={corr:ix("corr"),dt:ix("dt pr"),sig:ix("sigla"),so:ix("so"),l:ix("l"),sta:ix("sta"),el:H.findIndex(x=>x.includes("fora de faixa")),ano:ix("ano"),obs:ix("observa")};
    const out=[];
    for(const r of a.slice(h+1)){const corr=String(r[c.corr]||"").trim(); let dt=String(r[c.dt]||"").trim(); if(!corr||!dt)continue;
      let ano=c.ano>=0?String(r[c.ano]).trim():""; const m=dt.match(/^(\d{1,2})\/(\d{1,2})(?:\/(\d{2,4}))?/); if(!m)continue;
      if(m[3])ano=m[3].length===2?"20"+m[3]:m[3];
      out.push([corr,m[1].padStart(2,"0")+"/"+m[2].padStart(2,"0"),Number(ano)||new Date().getFullYear(),r[c.sig]||"",r[c.so]||"",r[c.l]||"",r[c.sta]||"",r[c.el]||"",c.obs>=0?r[c.obs]||"":""]);}
    return out;
  }
  return null;
}
$("file").onchange=e=>{
  const f=e.target.files[0]; if(!f)return;
  if(typeof XLSX==="undefined"){$("loadMsg").textContent="Não foi possível abrir o leitor de planilhas. Verifique a internet e tente de novo.";return;}
  $("loadMsg").textContent="Lendo "+f.name+"…";
  const rd=new FileReader();
  rd.onload=()=>{try{const rows=parseSheet(XLSX.read(rd.result,{type:"array"}));
      if(!rows||!rows.length){$("loadMsg").textContent="Não achei a coluna CORR e “Elemento fora de faixa” nesse arquivo.";return;}
      needDefault=true;setData(rows);
      const em=new Date().toLocaleString("pt-BR",{day:"2-digit",month:"2-digit",hour:"2-digit",minute:"2-digit"}).replace(" "," ");
      let salvo=true;try{localStorage.setItem("cq_base",JSON.stringify({rows,nome:f.name,em}));}catch(err){salvo=false;}
      $("loadMsg").textContent=salvo?`base salva neste navegador em ${em} · ${f.name}`:`${f.name} carregada · ${fmt(rows.length)} corridas (use o botão Código para gravar no arquivo)`;
    }catch(err){$("loadMsg").textContent="Erro ao ler a planilha: "+err.message;}};
  rd.readAsArrayBuffer(f); e.target.value="";
};

let SALVA=null;
try{SALVA=JSON.parse(localStorage.getItem("cq_base")||"null");}catch(e){}
if(SALVA&&Array.isArray(SALVA.rows)&&SALVA.rows.length){setData(SALVA.rows);}else{SALVA=null;setData(dadosPadraoIniciais);}
try{const s=JSON.parse(localStorage.getItem("cq_f")||"null");if(s){if([...$("fMes").options].some(o=>o.value===s.m))$("fMes").value=s.m;if([...$("fEl").options].some(o=>o.value===s.e))$("fEl").value=s.e;renderAll();}}catch(e){}
$("loadMsg").textContent=SALVA?`base salva neste navegador em ${SALVA.em} · ${SALVA.nome}`:"base: planilha de controle · Marlon Lacerda";
</script>

