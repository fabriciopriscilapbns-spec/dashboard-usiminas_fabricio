const MESES=["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"];
const PT=" · ";
let D=[];let RAW=[];let needDefault=true;
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const fmt=n=>n.toLocaleString("pt-BR");
const pct=(a,b)=>b?(a/b*100).toLocaleString("pt-BR",{minimumFractionDigits:1,maximumFractionDigits:1})+"%":"–";
function normEl(e){e=String(e||"").trim();if(!e)return"";if(/^ret/i.test(e))return"Retorno total";return e.toUpperCase();}

// row: [corr, dd/mm, ano, sigla, so, L, sta, elemento, obs]
function prep(rows){
  return rows.map((r,i)=>{
    const [dd,mm]=String(r[1]).split("/").map(Number); const ano=Number(r[2])||new Date().getFullYear();
    const els=String(r[7]||"").split(/[;,/]+/).map(normEl).filter(Boolean);
    return {corr:String(r[0]),dia:dd,mes:mm,ano,mk:ano+"-"+String(mm).padStart(2,"0"),ml:MESES[mm-1]+PT+ano,
      dt:ano*10000+mm*100+dd,sigla:r[3]||"",so:r[4]||"",l:String(r[5]||"").toUpperCase(),sta:r[6]||"",els,fora:els.length>0,obs:r[8]||"",i};
  }).filter(r=>r.mes>=1&&r.mes<=12);
}
function setData(rows){
  RAW=rows;
  D=prep(rows).sort((a,b)=>b.dt-a.dt||b.corr.localeCompare(a.corr,undefined,{numeric:true}));
  buildFilters(); renderAll();
}
const months=()=>[...new Set(D.map(r=>r.mk))].sort();
const mlabel=mk=>{const [y,m]=mk.split("-");return MESES[+m-1]+PT+y};
function elements(){const c={};D.forEach(r=>r.els.forEach(e=>c[e]=(c[e]||0)+1));return Object.keys(c).sort((a,b)=>c[b]-c[a]||a.localeCompare(b));}
function opts(sel,list,allLabel,keep){const v=sel.value;sel.innerHTML=(allLabel?`<option value="">${allLabel}</option>`:"")+list.map(([k,l])=>`<option value="${esc(k)}">${esc(l)}</option>`).join("");
  if(keep&&[...sel.options].some(o=>o.value===v))sel.value=v;}
function buildFilters(){
  const ms=months().slice().reverse().map(m=>[m,mlabel(m)]); const el=elements().map(e=>[e,e]);
  const last=ms[0]?.[0]||"";
  for(const id of["fMes","oMes","aMes"]){opts($(id),ms,"Todos",true);if(needDefault&&id!=="aMes")$(id).value=last;}
  needDefault=false;
  opts($("fEl"),el,"Todos",true);opts($("oEl"),el,"Todos",true);opts($("aEl"),el,null,true);
  const last2=D[0];
  $("sub").textContent=`Período: ${$("fMes").value?mlabel($("fMes").value):"todos os meses"}   ·   dado mais recente: ${last2?String(last2.dia).padStart(2,"0")+"/"+String(last2.mes).padStart(2,"0")+"/"+last2.ano:"–"}   ·   ${fmt(D.length)} corridas na base`;
}
function count(arr,key){const c=new Map();arr.forEach(r=>{const ks=key(r);(Array.isArray(ks)?ks:[ks]).forEach(k=>{if(k!==""&&k!=null)c.set(k,(c.get(k)||0)+1)})});return [...c.entries()].sort((a,b)=>b[1]-a[1]||String(a[0]).localeCompare(String(b[0])));}
function hbars(el,entries,{max=10,base=null,amber=false,click=null}={}){
  if(!entries.length){el.innerHTML='<div class="empty">Nenhuma corrida fora de faixa neste filtro.</div>';return;}
  const top=entries.slice(0,max),m=top[0][1];
  el.innerHTML=top.map(([k,v])=>`<div class="hr${amber?" am":""}${click?" click":""}" data-k="${esc(k)}"><span class="n" title="${esc(k)}">${esc(k||"(vazio)")}</span><span class="t"><i style="width:${(v/m*100).toFixed(1)}%"></i></span><span class="val">${fmt(v)}${base?` <small>${pct(v,base.get(k)||0)}</small>`:""}</span></div>`).join("")+(entries.length>max?`<div class="note">+ ${entries.length-max} outros</div>`:"");
  if(click)el.querySelectorAll(".hr").forEach(n=>n.onclick=()=>click(n.dataset.k));
}
function colchart(el,ms,val,tot,sel,onPick){
  const vals=ms.map(val),m=Math.max(1,...vals);
  el.innerHTML=ms.map((mk,i)=>{const v=vals[i],t=tot?tot(mk):0;return `<div class="col${mk===sel?" sel":""}" data-m="${mk}" title="${mlabel(mk)}: ${v}${tot?" de "+t+" corridas":""}"><span class="top">${fmt(v)}${tot?`<small>${pct(v,t)}</small>`:""}</span><div class="bar" style="height:${(v/m*100).toFixed(1)}%"></div><span class="x">${MESES[+mk.slice(5)-1]}</span></div>`}).join("");
  el.querySelectorAll(".col").forEach(c=>c.onclick=()=>onPick(c.dataset.m));
}
const fd=r=>String(r.dia).padStart(2,"0")+"/"+String(r.mes).padStart(2,"0");
