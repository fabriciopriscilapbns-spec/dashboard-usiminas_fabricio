<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
</head>
<body>
<title>Composição Química AC 1 e 2</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
/* Layout: navy report band on top, yellow filter boxes, KPI tiles, then chart panels in a 3-column grid (same structure as the Retrabalho UNIGAL report) */
:root{
  --navy:#1B2430; --ink:#1B2430; --muted:#6B7685; --line:#DDE2E8;
  --bg:#EEF1F5; --card:#FFFFFF; --filter:#FFF4DC; --filter-line:#E8C27A;
  --bar:#0B5CAD; --bar2:#3F7FC1; --amber:#D98E04; --amber2:#C77D0A; --soft:#9DB7D5;
  --bad:#B4362B; --bad-bg:#FBE9E7; --ok:#2E7D4F;
  --head-fg:#FFFFFF; --head-muted:#B9C3D0; --green:#1E9A7A;
  --font:Calibri,"Source Sans 3","Segoe UI",Arial,sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --ink:#E6EAF0; --muted:#9AA5B4; --line:#2E3846; --bg:#11161D; --card:#1A212B;
  --filter:#3A2F17; --filter-line:#7A5E25; --bar:#4C93DD; --bar2:#6FA6DE; --amber:#F0A92A; --amber2:#E39A22; --soft:#3E5674;
  --bad:#F08A7E; --bad-bg:#3A1F1C; --ok:#6CC08E; --navy:#0B1017; color-scheme:dark}}
:root[data-theme="dark"]{
  --ink:#E6EAF0; --muted:#9AA5B4; --line:#2E3846; --bg:#11161D; --card:#1A212B;
  --filter:#3A2F17; --filter-line:#7A5E25; --bar:#4C93DD; --bar2:#6FA6DE; --amber:#F0A92A; --amber2:#E39A22; --soft:#3E5674;
  --bad:#F08A7E; --bad-bg:#3A1F1C; --ok:#6CC08E; --navy:#0B1017; color-scheme:dark}
*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:14px;line-height:1.35}
.wrap{max-width:1280px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header.band{background:var(--navy);color:var(--head-fg)}
header .wrap{padding-block:18px 0;display:flex;flex-direction:column;gap:12px}
.top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:flex-end;justify-content:space-between}
h1{font-size:22px;margin:0;letter-spacing:.02em;text-wrap:balance}
.sub{color:var(--head-muted);font-size:13px;margin-top:4px}
.filters{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
.f{display:flex;flex-direction:column;gap:3px;min-width:0}
.f label{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--head-muted);font-weight:600}
main .f label{color:var(--muted)}
select,input[type=search]{font:inherit;font-size:15px;font-weight:600;color:#1B2430;background:#FFF4DC;border:1px solid #E8C27A;border-radius:3px;padding:6px 10px;min-width:150px;max-width:100%}
main select,main input[type=search]{background:var(--filter);color:var(--ink);border-color:var(--filter-line)}
select:focus-visible,input:focus-visible,button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
nav.tabs{display:flex;gap:2px;overflow-x:auto}
nav.tabs button{font:inherit;font-weight:600;font-size:14px;background:transparent;color:var(--head-muted);border:0;border-bottom:3px solid transparent;padding:10px 14px;cursor:pointer;white-space:nowrap}
nav.tabs button[aria-selected=true]{color:#fff;border-bottom-color:#E8C27A}
.load{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn{font:inherit;font-weight:600;font-size:13px;background:transparent;color:#fff;border:1px solid #5A6778;border-radius:3px;padding:6px 12px;cursor:pointer}
.btn:hover{border-color:#E8C27A}
.msg{font-size:12px;color:var(--head-muted)}
main .wrap{padding-block:18px 40px;display:flex;flex-direction:column;gap:16px}
.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
.kpi{background:var(--card);padding:12px 14px;display:flex;flex-direction:column;gap:4px;min-width:0}
.kpi .l{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.kpi .v{font-size:28px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.1;overflow-wrap:anywhere}
.kpi .v.txt{font-size:18px}
.kpi .d{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.kpi.alert .v{color:var(--bad)}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.span2{grid-column:span 2}.span3{grid-column:1/-1}
.panel{background:var(--card);border:1px solid var(--line);padding:14px 16px;min-width:0;display:flex;flex-direction:column;gap:10px}
.panel h2{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0;font-weight:700;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.panel h2 small{font-weight:600;letter-spacing:0;text-transform:none}
.key{color:var(--amber)}
/* column chart */
.cols{display:flex;align-items:flex-end;gap:6px;height:200px;padding-top:30px}
.col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:0;cursor:pointer}
.col .bar{width:100%;max-width:46px;background:var(--bar);min-height:1px}
.col.sel .bar{background:var(--amber)}
.col .top{font-size:11.5px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--ink);margin-bottom:3px;display:block;text-align:center}
.col .top small{display:block;font-weight:600;color:var(--muted)}
.col .x{font-size:11.5px;color:var(--muted);margin-top:5px;white-space:nowrap}
/* horizontal bars */
.hb{display:flex;flex-direction:column;gap:6px}
.hr{display:grid;grid-template-columns:minmax(70px,38%) 1fr auto;gap:8px;align-items:center;font-size:13px}
.hr .n{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hr .t{height:14px;background:transparent}
.hr .t i{display:block;height:100%;background:var(--bar2)}
.hr.am .t i{background:var(--amber2)}
.hr .val{font-variant-numeric:tabular-nums;font-weight:600;text-align:right;white-space:nowrap}
.hr .val small{color:var(--muted);font-weight:400}
.hr.click{cursor:pointer}.hr.click:hover .n{text-decoration:underline}
.empty{color:var(--muted);font-size:13px;padding:8px 0}
/* tables */
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px;font-variant-numeric:tabular-nums}
th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);text-align:left;padding:7px 8px;border-bottom:2px solid var(--line);white-space:nowrap}
td{padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
td.nw{white-space:nowrap}
td.obs{min-width:220px;color:var(--muted)}
.chip{display:inline-block;font-weight:700;font-size:12px;padding:1px 7px;border-radius:2px;background:var(--bad-bg);color:var(--bad);white-space:nowrap}
.chip.ok{background:transparent;color:var(--ok);font-weight:600}
.sta{font-weight:600}.sta.r{color:var(--bad)}
.bar-row{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;justify-content:space-between}
.count{font-weight:700;font-size:15px}
.note{font-size:12px;color:var(--muted)}
.chk{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--ink);cursor:pointer;padding-bottom:6px}
@media (max-width:1000px){.kpis{grid-template-columns:repeat(3,minmax(0,1fr))}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.span2{grid-column:1/-1}}
@media (max-width:620px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.grid{grid-template-columns:minmax(0,1fr)}.cols{gap:3px}.col .x{font-size:10px}.col .top small{display:none}}

tr.ck{cursor:pointer}tr.ck:hover td{background:var(--bg)}
#chDia svg{display:block;min-width:640px;width:100%;height:auto}
#chDia .pt{cursor:pointer}#chDia path,#chDia line{pointer-events:none}
#chDia .pt:hover circle,#chDia .pt:focus circle{r:7}
#chDia .pt:focus{outline:none}
.ov{position:fixed;inset:0;background:rgba(11,16,23,.55);display:flex;align-items:center;justify-content:center;z-index:50;padding:max(16px,env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) max(16px,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.md{background:var(--card);color:var(--ink);width:min(760px,100%);max-height:100%;display:flex;flex-direction:column;border-radius:10px;box-shadow:0 20px 50px rgba(0,0,0,.35);overflow:hidden}
.md-h{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:18px 20px;border-bottom:1px solid var(--line)}
.md-h h3{margin:0;font-size:18px;letter-spacing:.02em}
.md-h p{margin:4px 0 0;color:var(--muted);font-size:13px}
.x-btn{font:inherit;font-size:20px;line-height:1;width:34px;height:34px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:6px;cursor:pointer;flex:none}
.md-b{overflow:auto;padding:16px 20px;display:flex;flex-direction:column;gap:12px}
.cd{border:1px solid var(--line);border-left:4px solid var(--bar);border-radius:6px;padding:14px 16px;display:flex;flex-direction:column;gap:10px;background:var(--card)}
.cd.r{border-left-color:var(--bad)}
.cd-t{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.cd-t b{font-size:15px}
.cd-t .s{color:var(--muted);font-size:13px}
.cd-g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 14px}
.cd-g span{display:block;font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:700}
.cd-g div{font-weight:600;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;min-width:0}
.cd-o{font-size:13px;display:flex;gap:8px;align-items:flex-start}
.cd-o .tag{background:var(--bad);color:#fff;font-size:11px;font-weight:700;padding:1px 6px;border-radius:3px;flex:none}
.cd-o.none{color:var(--muted)}
.go{font:inherit;font-weight:600;font-size:13px;text-align:center;padding:8px;border:1px solid var(--bar);color:var(--bar);background:transparent;border-radius:6px;cursor:pointer}
.go:hover{background:var(--bar);color:#fff}
@media (max-width:620px){.cd-g{grid-template-columns:repeat(2,minmax(0,1fr))}}

.ttl{display:flex;gap:12px;align-items:center}
.sq{width:14px;height:14px;border-radius:3px;background:var(--green);border:0;padding:0;cursor:default;flex:none}
.sq:focus-visible{outline:2px solid #E8C27A;outline-offset:2px}
.pw,.adm{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.pw input{font:inherit;font-size:14px;padding:6px 10px;border-radius:3px;border:1px solid #5A6778;background:#fff;color:#1B2430;width:150px}
.adm .btn{border-color:var(--green)}
.steps{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;font-size:14px}
.steps code{font-size:13px;background:var(--bg);padding:1px 5px;border-radius:3px}
.okmsg{font-weight:700;color:var(--ok)}
.codebox{width:100%;height:110px;font:12px/1.3 Consolas,monospace;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:4px;padding:8px;resize:vertical}

.btn.rel{background:var(--green);border-color:var(--green)}
.rov{position:fixed;inset:0;z-index:60;background:#2B333E;overflow:auto;padding:max(16px,env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) 40px max(16px,env(safe-area-inset-left,0px))}
.rbar{max-width:210mm;margin:0 auto 14px;display:flex;flex-wrap:wrap;gap:10px 14px;align-items:flex-end;color:#fff}
.rbar .f label{color:#B9C3D0}
.rbar select{background:#FFF4DC;color:#1B2430;border-color:#E8C27A}
.rbtns{display:flex;gap:8px;flex-wrap:wrap}
.btn.rp{background:#1E9A7A;border-color:#1E9A7A}
.rbar .msg{flex-basis:100%;color:#B9C3D0}
.rbar .codebox{background:#fff;color:#1B2430}
/* paper: deliberately fixed light palette (printed document) */
.paper{--ink:#1B2430;--muted:#5E6978;--line:#D5DBE3;--card:#FFFFFF;--bar:#0B5CAD;--p-ink:#1B2430;--p-mut:#5E6978;--p-line:#D5DBE3;--p-soft:#F3F5F8;--p-blue:#0B5CAD;--p-amber:#D98E04;--p-bad:#B4362B;--p-ok:#2E7D4F;
  background:#fff;color:var(--p-ink);width:210mm;max-width:100%;margin:0 auto;padding:12mm 12mm 10mm;font-family:var(--font);font-size:10.5pt;line-height:1.35;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.paper h2{font-size:10pt;letter-spacing:.07em;text-transform:uppercase;color:var(--p-mut);margin:0 0 6px;font-weight:700}
.rh{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;border-bottom:3px solid var(--p-ink);padding-bottom:8px}
.rh h1{font-size:17pt;margin:0;color:var(--p-ink)}
.rh .m{color:var(--p-mut);font-size:9.5pt;margin-top:2px}
.rh .per{text-align:right;font-size:9.5pt;color:var(--p-mut)}
.rh .per b{display:block;font-size:14pt;color:var(--p-ink)}
.rsec{margin-top:12px;break-inside:avoid}
.rk{display:grid;grid-template-columns:repeat(6,1fr);border:1px solid var(--p-line)}
.rk div{padding:7px 8px;border-right:1px solid var(--p-line)}
.rk div:last-child{border-right:0}
.rk span{display:block;font-size:7.5pt;letter-spacing:.06em;text-transform:uppercase;color:var(--p-mut);font-weight:700}
.rk b{display:block;font-size:15pt;font-variant-numeric:tabular-nums;line-height:1.15}
.rk small{font-size:8pt;color:var(--p-mut)}
.rk .up{color:var(--p-bad)}.rk .dn{color:var(--p-ok)}
.lr{background:var(--p-soft);border-left:4px solid var(--p-blue);padding:8px 12px}
.lr ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:3px}
.r2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.paper svg{width:100%;height:auto;display:block}
.paper table{color:var(--p-ink);width:100%;border-collapse:collapse;font-size:9pt;font-variant-numeric:tabular-nums}
.paper th{font-size:7.5pt;letter-spacing:.05em;text-transform:uppercase;color:var(--p-mut);text-align:left;padding:4px 5px;border-bottom:1.5px solid var(--p-ink)}
.paper td{padding:3.5px 5px;border-bottom:1px solid var(--p-line);vertical-align:top}
.paper td.n,.paper th.n{text-align:right}
.paper tr{break-inside:avoid}
.paper .el{font-weight:700;color:var(--p-bad)}
.paper .stR{color:var(--p-bad);font-weight:700}
.paper .obs{color:var(--p-mut)}
.rf{margin-top:12px;padding-top:6px;border-top:1px solid var(--p-line);font-size:8pt;color:var(--p-mut);display:flex;justify-content:space-between;gap:10px}
.paper .rtw{overflow-x:auto}
@media print{
  @page{size:A4;margin:10mm}
  html,body,:root{background:#fff!important;color-scheme:light!important}
  :root{padding:0!important}
  body>*:not(#rOv){display:none!important}
  #rOv{position:static!important;display:block!important;background:#fff;padding:0;overflow:visible}
  .rbar{display:none!important}
  .paper{box-shadow:none;width:auto;padding:0;margin:0}
  .paper,.paper *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>

<header class="band"><div class="wrap">
  <div class="top">
    <div class="ttl"><button type="button" class="sq" id="sq" aria-label="Área restrita (dois cliques)"></button><div><h1>COMPOSIÇÃO QUÍMICA · AC 1 E 2</h1><div class="sub" id="sub"></div></div></div>
    <div class="filters" id="headFilters">
      <div class="f"><label for="fMes">Mês ▾</label><select id="fMes"></select></div>
      <div class="f"><label for="fEl">Elemento ▾</label><select id="fEl"></select></div>
    </div>
  </div>
  <div class="top">
    <nav class="tabs" role="tablist">
      <button role="tab" data-t="painel" aria-selected="true">Painel</button>
      <button role="tab" data-t="ocorrencias" aria-selected="false">Ocorrências</button>
      <button role="tab" data-t="elemento" aria-selected="false">Análise por elemento</button>
    </nav>
    <div class="load" style="padding-bottom:8px">
      <span class="msg" id="loadMsg"></span>
      <button class="btn rel" type="button" id="btnRel">📄 Relatório PDF</button>
      <form class="pw" id="pwBox" hidden autocomplete="off">
        <input type="password" id="pwIn" placeholder="Senha" aria-label="Senha">
        <button class="btn" type="submit">Entrar</button>
        <span class="msg" id="pwMsg"></span>
      </form>
      <span class="adm" id="admBar" hidden>
        <label class="btn" for="file">⬆ Carregar planilha</label>
        <button class="btn" type="button" id="btnCode">&lt;/&gt; Código</button>
        <button class="btn" type="button" id="btnLock" aria-label="Bloquear" title="Bloquear">🔒</button>
      </span>
      <input id="file" type="file" accept=".xlsx,.xlsm,.xls" hidden>
    </div>
  </div>
</div></header>

<main>
<!-- PAINEL -->
<section id="painel"><div class="wrap">
  <div class="kpis" id="kpis"></div>
  <div class="grid">
    <div class="panel span2"><h2>Corridas fora de faixa por mês <small><span class="key">■</span> mês filtrado · rótulo = nº e % das corridas</small></h2><div class="cols" id="chMes"></div></div>
    <div class="panel"><h2>Elementos fora de faixa <small>nº de corridas</small></h2><div class="hb" id="chEl"></div></div>
    <div class="panel"><h2>Por SO <small>nº · % das corridas do SO</small></h2><div class="hb" id="chSO"></div></div>
    <div class="panel"><h2>Por L <small>nº · % das corridas do L</small></h2><div class="hb" id="chL"></div></div>
    <div class="panel"><h2>Por STA <small>nº de corridas fora de faixa</small></h2><div class="hb" id="chSTA"></div></div>
    <div class="panel span2"><h2>Siglas mais afetadas <small>nº de corridas fora de faixa</small></h2><div class="hb" id="chSig"></div></div>
    <div class="panel"><h2>Observações do período</h2><div class="hb" id="chObs"></div></div>
    <div class="panel span3"><h2>Evolução diária <small>nº de corridas fora de faixa por dia · clique num ponto para ver as corridas</small></h2><div class="tw"><div id="chDia"></div></div></div>
    <div class="panel span3"><h2><span id="tUltT">Corridas fora de faixa do período</span> <small>clique numa linha para ver os detalhes do dia</small></h2><div class="tw"><table id="tUlt"></table></div></div>
  </div>
</div></section>

<!-- OCORRÊNCIAS -->
<section id="ocorrencias" hidden><div class="wrap">
  <div class="panel">
    <div class="bar-row">
      <div class="filters">
        <div class="f"><label for="oMes">Mês</label><select id="oMes"></select></div>
        <div class="f"><label for="oEl">Elemento</label><select id="oEl"></select></div>
        <div class="f"><label for="oQ">Corrida ou sigla</label><input id="oQ" type="search" placeholder="digite o número ou parte dele"></div>
        <label class="chk"><input type="checkbox" id="oAll"> mostrar também as corridas dentro da faixa</label>
      </div>
      <div class="count" id="oCount"></div>
    </div>
    <div class="note">Lista da mais recente para a mais antiga (até 500 linhas).</div>
    <div class="tw"><table id="tOc"></table></div>
  </div>
</div></section>

<!-- ELEMENTO -->
<section id="elemento" hidden><div class="wrap">
  <div class="filters">
    <div class="f"><label for="aEl">Elemento</label><select id="aEl"></select></div>
    <div class="f"><label for="aMes">Mês</label><select id="aMes"></select></div>
  </div>
  <div class="kpis" id="aKpis"></div>
  <div class="grid">
    <div class="panel span2"><h2>Corridas com o elemento por mês <small><span class="key">■</span> mês filtrado</small></h2><div class="cols" id="aMesCh"></div></div>
    <div class="panel"><h2>Aparece junto com <small>mesma corrida</small></h2><div class="hb" id="aJunto"></div></div>
    <div class="panel"><h2>Por SO</h2><div class="hb" id="aSO"></div></div>
    <div class="panel"><h2>Por L</h2><div class="hb" id="aL"></div></div>
    <div class="panel"><h2>Siglas</h2><div class="hb" id="aSig"></div></div>
    <div class="panel span3"><h2>Corridas com o elemento</h2><div class="tw"><table id="tA"></table></div></div>
  </div>
</div></section>
</main>
<div class="rov" id="rOv" hidden role="dialog" aria-modal="true" aria-label="Relatório para supervisão">
  <div class="rbar">
    <div class="f"><label for="rMes">Mês do relatório</label><select id="rMes"></select></div>
