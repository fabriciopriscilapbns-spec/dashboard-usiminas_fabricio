<script>
if (typeof Chart !== 'undefined' && window.ChartDataLabels) Chart.register(ChartDataLabels);
const ORIGINAL_RAW = JSON.parse(document.getElementById('seed').textContent);
let RAW = ORIGINAL_RAW.slice();
let dbRef = null; /* capability "db" da plataforma — null se indisponível (link local, sem permissão, etc.) */
let cloudStatus = 'local'; /* 'local' | 'cloud' | 'saving' | 'error' */
function groupByVolume(rows) {
  /* um volume pode ter várias linhas: partes que caíram (soma o peso, 1x por parte)
     e/ou uma linha por anormalidade da placa (junta as anormalidades, sem somar peso de novo) */
  const map = new Map();
  rows.forEach(r => {
    let g = map.get(r.volume);
    if (!g) { g = Object.assign({}, r, { partes: 0, peso: 0, anormalidades: [], _pecas: new Set() }); map.set(r.volume, g); }
    const pk = (r.ordena !== undefined && r.ordena !== null) ? 'o' + r.ordena : 'p' + r.peso;
    if (!g._pecas.has(pk)) { g._pecas.add(pk); g.partes += 1; g.peso += Number(r.peso) || 0; }
    if (r.sucatamento === 'Sim') { g.sucatamento = 'Sim'; if (r.dataSucatamento) g.dataSucatamento = r.dataSucatamento; }
    if (r.dadoPlaca) g.dadoPlaca = true;
    ['escarfado','velProgA','velProgB','velRealA','velRealB','defFaceA','defFaceB'].forEach(k => { if ((g[k] === null || g[k] === undefined) && r[k] !== null && r[k] !== undefined) g[k] = r[k]; });
    const add = a => { if (a && a.desc && !g.anormalidades.some(x => x.desc === a.desc)) g.anormalidades.push(a); };
    (r.anormList || []).forEach(add);
    if (r.anormalidade) add({ cod: r.anormCod, desc: r.anormalidade });
  });
  return Array.from(map.values()).map(g => { delete g._pecas; if (g.anormalidades.length || g.escarfado) g.dadoPlaca = true; return g; })
    .sort((a,b)=>(b.dataSort||'').localeCompare(a.dataSort||''));
}
let ALL = groupByVolume(RAW);

function fmtTon(v) { return v.toLocaleString('pt-BR', {minimumFractionDigits:1, maximumFractionDigits:1}) + ' t'; }

let currentFiltered = [];
let ishiIdx = 0;
function aggBy(key) {
  const m = new Map();
  currentFiltered.forEach(o => { if (!o[key]) return; m.set(o[key], (m.get(o[key])||0) + o.peso); });
  return Array.from(m.entries()).sort((a,b)=>b[1]-a[1]);
}

/* vermelho suave pra 1a posição, degradê de verde (escuro -> claro) pro resto */
function rankColor(i, n) {
  if (i === 0) return '#E57373';
  const dark = [0x1F,0x5C,0x3B], light = [0xBB,0xE8,0xC8];
  const t = n > 2 ? (i-1)/(n-2) : 0;
  const rgb = dark.map((d,k)=>Math.round(d+(light[k]-d)*t));
  return 'rgb('+rgb.join(',')+')';
}
function renderRank(elId, agg, maxItems, valFmt, dimKey) {
  const el = document.getElementById(elId);
  const top = agg.slice(0, maxItems);
  const max = top.length ? top[0][1] : 1;
  const total = agg.reduce((s,a)=>s+a[1],0);
  const hasSel = rankFilter && rankFilter.dim === dimKey;
  el.innerHTML = top.map((a,i) => {
    const isSel = hasSel && rankFilter.value === a[0];
    const isDimmed = hasSel && !isSel;
    return `
    <div class="rank-item ${isSel?'selected':''} ${isDimmed?'dimmed':''}" data-dim="${dimKey}" data-val="${esc(a[0])}">
      <div class="rank-pos">${i+1}</div>
      <div class="rank-body">
        <div class="rank-name" title="${esc(a[0])}">${esc(a[0])}</div>
        <div class="rank-bar-bg"><div class="rank-bar-fill" style="width:${(a[1]/max*100).toFixed(0)}%;background:${rankColor(i, top.length)}"></div></div>
      </div>
      <div class="rank-val">${valFmt(a[1])}</div>
      <div class="rank-pct">${(a[1]/total*100).toFixed(0)}%</div>
    </div>`;
  }).join('');
  el.querySelectorAll('.rank-item').forEach(item => {
    item.onclick = () => toggleRankFilter(item.dataset.dim, item.dataset.val);
  });
}

function renderAll() {
  const totalPeso = currentFiltered.reduce((s,o)=>s+o.peso,0);

  // periodo (sempre mostra o periodo TOTAL da base, nao do filtro, pra servir de referencia fixa)
  const diasBase = [...new Set(ALL.map(o=>o.dia).filter(Boolean))].sort();
  if (diasBase.length) {
    const f = d => { const p=d.split('-'); return p[2]+'/'+p[1]+'/'+p[0]; };
    document.getElementById('periodoTxt').textContent = f(diasBase[0]) + ' a ' + f(diasBase[diasBase.length-1]);
  }
  document.getElementById('dataGeracao').textContent = new Date().toLocaleDateString('pt-BR', {day:'2-digit',month:'2-digit',year:'numeric'});

  document.getElementById('kpiPeso').textContent = fmtTon(totalPeso);
  document.getElementById('kpiVolumes').textContent = currentFiltered.length;
  const kpiVolNoteEl = document.getElementById('kpiVolumesNote');
  if (currentFiltered.length === 1) {
    kpiVolNoteEl.innerHTML = 'Volume <b style="font-family:var(--mono);color:var(--accent-dark);font-size:13px">' + currentFiltered[0].volume + '</b>';
  } else if (currentFiltered.length > 1 && currentFiltered.length <= 5) {
    kpiVolNoteEl.innerHTML = 'Volumes: <b style="font-family:var(--mono);color:var(--accent-dark)">' + currentFiltered.map(o=>o.volume).join(', ') + '</b>';
  } else {
    kpiVolNoteEl.textContent = new Set(currentFiltered.map(o=>o.cliente)).size + ' clientes únicos';
  }

  const sucList = currentFiltered.filter(o=>o.sucatamento==='Sim');
  const sucPeso = sucList.reduce((s,o)=>s+o.peso,0);
  document.getElementById('kpiEscarf').textContent = currentFiltered.length ? Math.round(sucList.length/currentFiltered.length*100)+'%' : '0%';
  document.getElementById('kpiEscarfNote').textContent = sucList.length + ' de ' + currentFiltered.length + ' volumes · ' + fmtTon(sucPeso);


  // tendencia semanal
  const m = new Map();
  currentFiltered.forEach(o => { if(!o.semana) return; m.set(o.semana, (m.get(o.semana)||0)+o.peso); });
  const weeks = Array.from(m.keys()).sort();
  const values = weeks.map(w=>+m.get(w).toFixed(1));
  if (weeks.length >= 2) {
    const last = values[values.length-1];
    const prevAvg = values.slice(0,-1).reduce((s,v)=>s+v,0)/(values.length-1);
    const diffPct = prevAvg>0 ? ((last-prevAvg)/prevAvg)*100 : 0;
    const cls = diffPct>3?'up':(diffPct<-3?'down':'flat');
    const arrow = diffPct>3?'▲':(diffPct<-3?'▼':'—');
    const trendEl = document.getElementById('kpiPesoTrend');
    trendEl.className = 'trend ' + cls;
    trendEl.textContent = arrow + ' ' + (diffPct>=0?'+':'') + diffPct.toFixed(0) + '% última semana vs. média anterior';
  }

  const maxWeekIdx = values.length ? values.indexOf(Math.max(...values)) : -1;
  const weekSel = rankFilter && rankFilter.dim === 'semana' ? rankFilter.value : null;
  const weekColors = weeks.map((w,i) => {
    const base = rankColor(i===maxWeekIdx ? 0 : 1, 2); // reaproveita a mesma paleta (vermelho pra maior, verde pro resto)
    if (weekSel && w !== weekSel) return 'rgba(148,163,184,0.35)'; // esmaece as nao selecionadas
    return base;
  });
  if (window.__chart) window.__chart.destroy();
  window.__chart = new Chart(document.getElementById('chartSemana'), {
    type: 'bar',
    data: { labels: weeks, datasets: [{ data: values, backgroundColor: weekColors, borderRadius: 4, barThickness: 30 }] },
    options: {
      responsive: true, maintainAspectRatio: false,
      onClick: (evt, els) => { if (els.length) toggleRankFilter('semana', weeks[els[0].index]); },
      onHover: (evt, els) => { evt.native.target.style.cursor = els.length ? 'pointer' : 'default'; },
      layout: { padding: { top: 24 } },
      plugins: {
        legend:{display:false}, tooltip:{callbacks:{label: c=>c.parsed.y.toFixed(1)+' t'}},
        datalabels: {
          anchor: 'end', align: 'top', color: '#0F172A',
          font: { family: "'IBM Plex Mono'", weight: '700', size: 11 },
          formatter: v => v.toFixed(1)
        }
      },
      scales: {
        y: { grid: { color: '#F1F5F9' }, ticks: { font: { family: "'IBM Plex Mono'", size: 10 }, color: '#64748B' } },
        x: { grid: { display:false }, ticks: { font: { family: "'IBM Plex Mono'", size: 10.5 }, color: '#475569' } }
      }
    }
  });

  // evolucao diaria (grafico de linha)
  const mDay = new Map();
  const mDayOccs = new Map();
  currentFiltered.forEach(o => {
    if (!o.dia) return;
    mDay.set(o.dia, (mDay.get(o.dia)||0)+o.peso);
    if (!mDayOccs.has(o.dia)) mDayOccs.set(o.dia, []);
    mDayOccs.get(o.dia).push(o);
  });
  const days = Array.from(mDay.keys()).sort();
  const dayValues = days.map(d => +mDay.get(d).toFixed(1));
  const daySel = document.getElementById('fDiaExec').value;
  if (window.__chartDaily) window.__chartDaily.destroy();
  window.__chartDaily = new Chart(document.getElementById('chartDiario'), {
    type: 'line',
    data: {
      labels: days.map(d => { const p=d.split('-'); return p[2]+'/'+p[1]; }),
      datasets: [{
        data: dayValues,
        borderColor: '#0F766E',
        backgroundColor: 'rgba(13, 148, 136, 0.08)',
        fill: true, tension: 0.3,
        pointBackgroundColor: days.map(d => d===daySel ? '#E57373' : '#0F766E'),
        pointBorderColor: '#FFFFFF', pointBorderWidth: 2,
        pointRadius: days.map(d => d===daySel ? 7 : 4), pointHoverRadius: 8,
        borderWidth: 2
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      layout: { padding: { top: 22 } },
      onClick: (evt, els) => {
        if (!els.length) return;
        const d = days[els[0].index];
        abrirDayModalExec(d, mDayOccs.get(d) || []);
      },
      onHover: (evt, els) => { evt.native.target.style.cursor = els.length ? 'pointer' : 'default'; },
      plugins: {
        legend:{display:false},
        tooltip:{callbacks:{label: c=>c.parsed.y.toFixed(1)+' t', afterLabel: () => '➜ clique para ver as ocorrências'}},
        datalabels: {
          anchor: 'end', align: 'top', color: '#0F172A', backgroundColor:'#FFFFFF', borderColor:'#CBD5E1', borderWidth:1, borderRadius:4,
          padding:{top:1,bottom:1,left:4,right:4}, font: { family: "'IBM Plex Mono'", weight: '700', size: 9.5 },
          formatter: v => v.toFixed(1)
        }
      },
      scales: {
        y: { grid: { color: '#F1F5F9' }, ticks: { font: { family: "'IBM Plex Mono'", size: 10 }, color: '#64748B' } },
        x: { grid: { color: '#F1F5F9' }, ticks: { font: { family: "'IBM Plex Mono'", size: 10, color: '#475569' } } }
      }
    }
  });

  renderRank('rankMotivo', aggBy('motivo'), 5, v=>fmtTon(v), 'motivo');
  renderRank('rankCliente', aggBy('cliente'), 5, v=>fmtTon(v), 'cliente');
  renderRank('rankSetor', aggBy('setor'), 5, v=>fmtTon(v), 'setor');
  renderRank('rankLinha', aggBy('localQueda'), 5, v=>fmtTon(v), 'localQueda');
  renderRank('rankLinhaRetrab', aggBy('tipoQualidade'), 5, v=>fmtTon(v), 'tipoQualidade');
}

document.getElementById('printBtn').addEventListener('click', () => window.print());

/* ---------- análise detalhada por volume: filtros + Ishikawa + anotação ---------- */
function esc(s) { if (s===null||s===undefined) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function fmtNum(v) { return (v===null||v===undefined) ? '—' : v.toFixed(1); }
function fmtDefEscarf(o) {
  const a = o.defFaceA, b = o.defFaceB;
  if (a || b) {
    let rows = '';
    if (a) rows += '<div class="row"><dt>Defeito Face A</dt><dd style="color:var(--alert)">'+esc(a)+'</dd></div>';
    if (b) rows += '<div class="row"><dt>Defeito Face B</dt><dd style="color:var(--alert)">'+esc(b)+'</dd></div>';
    return rows;
  }
  return '<div class="row"><dt>Defeito de Escarfagem</dt><dd>'+(o.dadoPlaca?'Não':'—')+'</dd></div>';
}
const SEM_DADO = '<div style="font-size:12px;color:#94A3B8;">Sem dado da placa nesta planilha.</div>';

function populateExecFilters() {
  const vSel = document.getElementById('fVolumeExec');
  vSel.innerHTML = '<option value="">Volume (todos)</option>';
  ALL.slice().sort((a,b)=>(b.dataSort||'').localeCompare(a.dataSort||'')).forEach(o => {
    const opt = document.createElement('option'); opt.value = o.volume; opt.textContent = o.volume + ' — ' + o.motivo;
    vSel.appendChild(opt);
  });
  const mSel = document.getElementById('fMotivoExec');
  mSel.innerHTML = '<option value="">Motivo (todos)</option>';
  [...new Set(ALL.map(o=>o.motivo))].sort().forEach(m => {
    const opt = document.createElement('option'); opt.value = m; opt.textContent = m;
    mSel.appendChild(opt);
  });
  const dSel = document.getElementById('fDiaExec');
  dSel.innerHTML = '<option value="">Dia (todos)</option>';
  [...new Set(ALL.map(o=>o.dia).filter(Boolean))].sort().reverse().forEach(d => {
    const p = d.split('-'); const opt = document.createElement('option'); opt.value = d; opt.textContent = p[2]+'/'+p[1]+'/'+p[0];
    dSel.appendChild(opt);
  });
  const mesSel = document.getElementById('fMesExec');
  mesSel.innerHTML = '<option value="">Mês (todos)</option>';
  [...new Set(ALL.map(o=>o.mes).filter(Boolean))].sort().forEach(me => {
    const p = me.split('-'); const opt = document.createElement('option'); opt.value = me; opt.textContent = p[1]+'/'+p[0];
    mesSel.appendChild(opt);
  });
}

let rankFilter = null; /* { dim: 'motivo'|'cliente'|'setor'|'semana', value } — cross-filtro por clique, estilo Power BI */
const RANK_DIM_LABEL = { motivo: 'Motivo', cliente: 'Cliente', setor: 'Setor Destino', semana: 'Semana', localQueda: 'Local da Queda', tipoQualidade: 'Enquadramento' };

function matchesFilters(o) {
  const volSel = document.getElementById('fVolumeExec').value;
  if (volSel) return String(o.volume) === volSel;
  const motSel = document.getElementById('fMotivoExec').value;
  const diaSel = document.getElementById('fDiaExec').value;
  const mesSel = document.getElementById('fMesExec').value;
  if (motSel && o.motivo !== motSel) return false;
  if (diaSel && o.dia !== diaSel) return false;
  if (mesSel && o.mes !== mesSel) return false;
  if (rankFilter && String(o[rankFilter.dim]) !== rankFilter.value) return false;
  return true;
}

function toggleRankFilter(dim, value) {
  if (rankFilter && rankFilter.dim === dim && rankFilter.value === value) rankFilter = null;
  else rankFilter = { dim, value };
  if (dim === 'motivo') document.getElementById('fMotivoExec').value = rankFilter ? value : '';
  applyExecFilter();
