/* tenta conectar ao banco da plataforma; se não houver (ou der erro), segue com a base padrão sem quebrar nada */
async function initCloudSync() {
  try {
    if (typeof window.claude === 'undefined' || !window.claude.use) { updateCloudStatusUI(); rebuildAllExec(); return; }
    dbRef = await window.claude.use('db');
    if (!dbRef) { cloudStatus = 'local'; updateCloudStatusUI(); rebuildAllExec(); return; }

    try {
      const snap = await dbRef.doc('data/rawRows').get();
      if (snap.exists && snap.data() && Array.isArray(snap.data().rows) && snap.data().rows.length) {
        RAW = snap.data().rows;
        cloudStatus = 'cloud';
        updateCloudStatusUI(snap.data());
      } else {
        cloudStatus = 'local';
        updateCloudStatusUI();
      }
    } catch (e) {
      cloudStatus = 'local'; updateCloudStatusUI();
    }

    try {
      const notesSnap = await dbRef.collection('notes').get();
      notesSnap.docs.forEach(d => { if (d.exists && d.data() && d.data().text) notesStore[d.id] = d.data().text; });
    } catch (e) { /* mantém o que já tinha local */ }

  } catch (e) {
    dbRef = null; cloudStatus = 'local'; updateCloudStatusUI();
  }
  rebuildAllExec();
}

function rebuildAllExec() {
  ALL = groupByVolume(RAW);
  rankFilter = null;
